<Window x:Class="WPMOverlay.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Typing History &amp; Analytics"
        Icon="pack://application:,,,/app_icon.ico"
        Height="540" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📊" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Typing Performance History" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📥 Export CSV" Click="ExportCsv_Click" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource AppSurfaceElevatedBrush}" Foreground="{DynamicResource AppAccentBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Cursor="Hand"/>
                <Button Content="🔄 Refresh" Click="Refresh_Click" Padding="12,6" Background="{DynamicResource AppSurfaceElevatedBrush}" Foreground="{DynamicResource AppTextSecondaryBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- KPI Summary Cards -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">
            <!-- All-Time Top -->
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="4">
                <StackPanel>
                    <TextBlock Text="ALL-TIME TOP" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtAllTimeTop" Text="0 WPM" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Today's Top -->
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppHighlightBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="4">
                <StackPanel>
                    <TextBlock Text="TODAY'S TOP" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtTodayTop" Text="0 WPM" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppHighlightBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Lifetime Average -->
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4">
                <StackPanel>
                    <TextBlock Text="LIFETIME AVG" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtLifetimeAvg" Text="0 WPM" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Words -->
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4">
                <StackPanel>
                    <TextBlock Text="TOTAL WORDS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtTotalWords" Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Sessions -->
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4">
                <StackPanel>
                    <TextBlock Text="TOTAL SESSIONS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtTotalSessions" Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- DataGrid of Sessions -->
        <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2">
            <DataGrid x:Name="GridSessions"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      Foreground="{DynamicResource AppTextPrimaryBrush}"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource AppBorderBrush}"
                      RowBackground="{DynamicResource AppSurfaceBrush}"
                      AlternatingRowBackground="{DynamicResource AppSurfaceElevatedBrush}"
                      HeadersVisibility="Column"
                      CanUserResizeRows="False"
                      SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                    </Style>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding FormattedDate}" Width="160"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="80"/>
                    <DataGridTextColumn Header="Keystrokes" Binding="{Binding GrossKeystrokes}" Width="85"/>
                    <DataGridTextColumn Header="Backspaces" Binding="{Binding Backspaces}" Width="85"/>
                    <DataGridTextColumn Header="Accuracy" Binding="{Binding FormattedAccuracy}" Width="85"/>
                    <DataGridTextColumn Header="Net Words" Binding="{Binding NetWords, StringFormat={}{0:F1}}" Width="85"/>
                    <DataGridTextColumn Header="Avg WPM" Binding="{Binding FormattedAvgWpm}" Width="100"/>
                    <DataGridTextColumn Header="Peak WPM" Binding="{Binding FormattedPeakWpm}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Controls -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button Content="🗑️ Clear All History" Click="ClearHistory_Click" HorizontalAlignment="Left" Padding="12,6" Background="{DynamicResource AppSurfaceElevatedBrush}" Foreground="#EF4444" BorderBrush="#DC2626" Cursor="Hand"/>
            <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" Padding="20,6" Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppTextOnAccentBrush}" BorderBrush="{DynamicResource AppAccentBrush}" Cursor="Hand" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
